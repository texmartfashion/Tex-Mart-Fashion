rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isAuthenticated() && request.auth.token.email.lower() == 'texmartfashion01@gmail.com';
    }

    // Public read for garments catalog, only super admin can modify
    match /products/{productId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // Categories
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // Orders: Anyone can submit an order, anyone can track order, only super admin can verify/update
    match /orders/{orderId} {
      allow create: if true;
      allow read: if true;
      allow update, delete: if isSuperAdmin();
    }

    // Settings
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // Users
    match /users/{userId} {
      allow read, write: if true;
    }

    // Test connection document
    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
